<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Generator SP Invoice - Koperasi Digdaya Mitra Mandiri</title>
  <style>
    :root {
      --primary: #1b5e20;
      --bg-panel: #f4f6f8;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Times New Roman", Times, serif;
      background-color: var(--bg-panel);
      color: #111;
      display: flex;
      min-height: 100vh;
    }

    /* LAYAR KUNCI PIN */
    .lock-overlay {
      position: fixed;
      inset: 0;
      background: #1b5e20;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
      font-family: Arial, Helvetica, sans-serif;
    }

    .lock-card {
      background: #ffffff;
      padding: 28px 24px;
      border-radius: 10px;
      width: 100%;
      max-width: 340px;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }

    .lock-card h3 {
      margin: 0 0 6px;
      color: #1b5e20;
      font-size: 18px;
    }

    .lock-card p {
      margin: 0 0 16px;
      font-size: 12.5px;
      color: #555;
    }

    .lock-card input {
      width: 100%;
      padding: 10px;
      font-size: 16px;
      text-align: center;
      letter-spacing: 3px;
      border: 1px solid #ccc;
      border-radius: 6px;
      margin-bottom: 12px;
    }

    .lock-error {
      color: #d32f2f;
      font-size: 12px;
      margin-top: 8px;
      display: none;
    }

    /* PANEL INPUT (KIRI) */
    .editor-panel {
      width: 420px;
      flex-shrink: 0;
      background: #ffffff;
      border-right: 1px solid #dcdcdc;
      padding: 18px;
      overflow-y: auto;
      height: 100vh;
      position: sticky;
      top: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    .editor-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--primary);
      padding-bottom: 8px;
      margin-bottom: 14px;
    }

    .editor-header h2 {
      margin: 0;
      font-size: 16px;
      color: var(--primary);
    }

    .form-group {
      margin-bottom: 10px;
    }

    .form-group label {
      display: block;
      font-size: 11.5px;
      font-weight: bold;
      margin-bottom: 4px;
      color: #444;
    }

    .form-group input,
    .form-group textarea,
    .item-card input {
      width: 100%;
      min-width: 0;
      padding: 7px 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 12.5px;
      font-family: inherit;
    }

    .row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .btn {
      display: inline-block;
      padding: 7px 10px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12.5px;
      font-weight: bold;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #fff;
      width: 100%;
      padding: 11px;
      font-size: 14px;
      margin-top: 8px;
    }

    .btn-secondary {
      background-color: #e8ece9;
      color: #1b5e20;
      border: 1px solid #c8d6cc;
    }

    .btn-danger {
      background-color: #d32f2f;
      color: #fff;
      padding: 3px 7px;
      font-size: 11px;
    }

    .btn-lock {
      background-color: #f0f0f0;
      color: #444;
      padding: 4px 8px;
      font-size: 11px;
    }

    .item-card {
      background: #f9f9f9;
      border: 1px solid #e0e0e0;
      padding: 9px;
      border-radius: 6px;
      margin-bottom: 8px;
    }

    .item-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      font-size: 12px;
      font-weight: bold;
      color: #333;
    }

    .item-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      margin-bottom: 6px;
    }

    .field-mini label {
      display: block;
      font-size: 10px;
      color: #666;
      margin-bottom: 2px;
    }

    /* AREA PRATINJAU SURAT (KANAN) */
    .preview-area {
      flex: 1;
      padding: 28px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      overflow-y: auto;
    }

    .letter-sheet {
      width: 210mm;
      min-height: 297mm;
      background: #ffffff;
      padding: 15mm 20mm;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      font-size: 12pt;
      line-height: 1.45;
    }

    /* KOP SURAT */
    .kop-surat {
      display: flex;
      align-items: center;
      border-bottom: 3px double #000;
      padding-bottom: 10px;
      margin-bottom: 16px;
    }

    .kop-logo {
      width: 78px;
      height: 78px;
      object-fit: contain;
      margin-right: 14px;
    }

    .kop-text {
      flex: 1;
      text-align: center;
    }

    .kop-text h1 {
      margin: 0;
      font-size: 15.5pt;
      font-weight: bold;
      line-height: 1.2;
    }

    .kop-text p {
      margin: 4px 0 0;
      font-size: 10.5pt;
      line-height: 1.35;
    }

    /* HEADER SURAT */
    .surat-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .surat-meta td {
      padding: 1px 6px 1px 0;
      vertical-align: top;
    }

    .surat-tujuan {
      margin-bottom: 14px;
    }

    .surat-body p {
      margin: 0 0 10px;
      text-align: justify;
    }

    .surat-poin {
      margin: 0 0 14px 18px;
      padding: 0;
    }

    .surat-poin li {
      margin-bottom: 4px;
    }

    /* TABEL REKAPITULASI */
    .rekap-table {
      width: 100%;
      border-collapse: collapse;
      margin: 12px 0 16px;
      font-size: 11pt;
    }

    .rekap-table th,
    .rekap-table td {
      border: 1px solid #000;
      padding: 6px 8px;
    }

    .rekap-table th {
      background-color: #f2f2f2;
      text-align: center;
      font-weight: bold;
      line-height: 1.25;
    }

    .text-center { text-align: center; }
    .text-right { text-align: right; }

    .rp-cell {
      border-right: none !important;
      width: 28px;
      text-align: left;
    }

    .val-cell {
      border-left: none !important;
      text-align: right;
    }

    .total-row td {
      font-weight: bold;
      background-color: #fafafa;
    }

    /* TANDA TANGAN KANAN BAWAH */
    .signature-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: 24px;
      page-break-inside: avoid;
    }

    .sig-box {
      text-align: center;
      width: 250px;
    }

    .sig-space {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sig-img {
      max-height: 76px;
      max-width: 200px;
      object-fit: contain;
    }

    .sig-name {
      font-weight: bold;
      text-decoration: underline;
    }

    /* ATURAN CETAK */
    @media print {
      body {
        background: #fff;
      }
      .editor-panel,
      .lock-overlay {
        display: none !important;
      }
      .preview-area {
        padding: 0;
        display: block;
      }
      .letter-sheet {
        box-shadow: none;
        width: 100%;
        min-height: auto;
        padding: 0;
      }
      @page {
        size: A4 portrait;
        margin: 14mm 18mm;
      }
    }
  </style>
</head>
<body>

  <!-- LAYAR KUNCI PIN -->
  <div id="lockScreen" class="lock-overlay">
    <div class="lock-card">
      <h3>Akses Terbatas</h3>
      <p>Surat Pengantar Invoice KDMM<br>Masukkan PIN untuk membuka halaman.</p>
      <input type="password" id="pinInput" placeholder="••••••" onkeydown="if(event.key==='Enter') unlockApp()" />
      <button type="button" class="btn btn-primary" style="margin-top: 0;" onclick="unlockApp()">Buka Aplikasi</button>
      <div id="lockError" class="lock-error">PIN salah. Silakan coba lagi.</div>
    </div>
  </div>

  <!-- PANEL INPUT DATA -->
  <div class="editor-panel">
    <div class="editor-header">
      <h2>Input Surat Pengantar</h2>
      <button type="button" class="btn btn-lock" onclick="lockApp()">Kunci</button>
    </div>

    <div class="row-2">
      <div class="form-group">
        <label>Nomor Surat</label>
        <input type="text" id="inNoSurat" value="056/DMM/K/VIII/2026" oninput="render()" />
      </div>
      <div class="form-group">
        <label>Tanggal Surat</label>
        <input type="text" id="inTanggalSurat" value="Temanggung, 22 Agustus 2026" oninput="render()" />
      </div>
    </div>

    <div class="row-2">
      <div class="form-group">
        <label>Lampiran</label>
        <input type="text" id="inLampiran" value="1 Set" oninput="render()" />
      </div>
      <div class="form-group">
        <label>Kepada Yth.</label>
        <input type="text" id="inKepada" value="Kepala SPPG Tretep" oninput="render()" />
      </div>
    </div>

    <div class="form-group">
      <label>Perihal</label>
      <input type="text" id="inPerihal" value="Invoice Belanja Bahan SPPG Tretep" oninput="render()" />
    </div>

    <div class="form-group">
      <label>Poin 1 (Penyajian Menu)</label>
      <input type="text" id="inPoin1" value="Penyajian Menu 18-21 Agustus 2026" oninput="render()" />
    </div>

    <div class="form-group">
      <label>Poin 2 (Rekening Tujuan)</label>
      <input type="text" id="inPoin2" value="Nomor rekening 692101009251501 Bank BRI atas nama Masykur Azka Farkhan" oninput="render()" />
    </div>

    <hr style="border: 0; border-top: 1px solid #eee; margin: 12px 0;">

    <div class="form-group">
      <label>Tempel Cepat dari Excel (4 Kolom)</label>
      <textarea id="bulkInput" rows="3" placeholder="Blok 4 kolom: Periode [Tab] Penyajian Menu [Tab] Tagihan [Tab] Keterangan..."></textarea>
      <button type="button" class="btn btn-secondary" style="margin-top: 6px; width: 100%;" onclick="importFromExcel()">+ Masukkan Data Paste ke Tabel</button>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin: 12px 0 8px;">
      <strong style="font-size: 12.5px;">Daftar Nota / Tagihan</strong>
      <button type="button" class="btn btn-secondary" onclick="addItem()">+ Tambah Baris</button>
    </div>

    <div id="itemsContainer"></div>

    <hr style="border: 0; border-top: 1px solid #eee; margin: 12px 0;">

    <details style="font-size: 12px; margin-bottom: 10px;">
      <summary style="cursor: pointer; font-weight: bold; color: #444;">Pengaturan Logo & TTD (Tersimpan di Browser)</summary>
      <div style="margin-top: 10px;">
        <div class="form-group">
          <label>Logo Koperasi (PNG/JPG)</label>
          <input type="file" accept="image/*" onchange="saveImage(event, 'logoKoperasi')" />
        </div>
        <div class="form-group">
          <label>TTD + Stempel Manager Keuangan</label>
          <input type="file" accept="image/*" onchange="saveImage(event, 'ttdManager')" />
        </div>
        <button type="button" class="btn btn-danger" onclick="clearImages()">Hapus Gambar Tersimpan</button>
      </div>
    </details>

    <button type="button" class="btn btn-primary" onclick="window.print()">Cetak / Simpan PDF</button>
  </div>

  <!-- AREA PRATINJAU SURAT -->
  <div class="preview-area">
    <div class="letter-sheet">
      <div class="kop-surat">
        <img id="outLogo" class="kop-logo" src="" alt="Logo" style="display: none;" />
        <div class="kop-text">
          <h1>KOPERASI "DIGDAYA MITRA<br>MANDIRI" PCNU TEMANGGUNG</h1>
          <p>Gedung PCNU Lantai 2, Jln. Jenderal Sudirman, No. 60,<br>Jampirejo Barat, Jampirejo, Kecamatan Temanggung,<br>Kabupaten Temanggung, Provinsi Jawa Tengah, 56218</p>
        </div>
      </div>

      <div class="surat-top">
        <table class="surat-meta">
          <tr>
            <td style="width: 65px;">No</td>
            <td>: <span id="outNoSurat"></span></td>
          </tr>
          <tr>
            <td>Lamp.</td>
            <td>: <span id="outLampiran"></span></td>
          </tr>
          <tr>
            <td>Perihal</td>
            <td>: <strong><span id="outPerihal"></span></strong></td>
          </tr>
        </table>
        <div id="outTanggalSurat"></div>
      </div>

      <div class="surat-tujuan">
        Kepada:<br>
        Yth. <strong><span id="outKepada"></span></strong><br>
        Di Tempat
      </div>

      <div class="surat-body">
        <p><em>Assalamualaikum Warahmatullahi Wabarakatuh</em></p>
        <p>Dengan hormat, menunjuk perihal pokok surat tersebut di atas, dengan ini kami dari Koperasi Digdaya Mitra Mandiri PCNU Temanggung menyampaikan nota pembayaran / invoice terkait pembelian beberapa kebutuhan bahan baku dengan rekapitulasi sebagai berikut :</p>
      </div>

      <ol class="surat-poin">
        <li id="outPoin1"></li>
        <li id="outPoin2"></li>
      </ol>

      <table class="rekap-table">
        <thead>
          <tr>
            <th style="width: 36px;">NO</th>
            <th>PERIODE</th>
            <th>PENYAJIAN MENU/<br>OPERASIONAL</th>
            <th colspan="2" style="width: 135px;">JUMLAH<br>TAGIHAN</th>
            <th>KETERANGAN</th>
          </tr>
        </thead>
        <tbody id="outTableBody"></tbody>
        <tfoot>
          <tr class="total-row">
            <td colspan="3" class="text-center">JUMLAH</td>
            <td class="rp-cell">Rp</td>
            <td class="val-cell" id="outGrandTotal">0</td>
            <td></td>
          </tr>
        </tfoot>
      </table>

      <div class="surat-body">
        <p>Adapun lembar invoice kami sampaikan sesuai dengan hari pengiriman, lembar invoice lengkap terlampir.</p>
        <p>Demikian nota pembayaran kami sampaikan. Atas perhatian dan kerja samanya kami ucapkan terima kasih. <em>Wassalamualaikum Warahmatullahi Wabarakatuh</em></p>
      </div>

      <div class="signature-wrapper">
        <div class="sig-box">
          <div>Koperasi Digdaya Mitra Mandiri</div>
          <div class="sig-space">
            <img id="outTtdManager" class="sig-img" src="" alt="" style="display: none;" />
          </div>
          <div class="sig-name">BUDI RAHARJO</div>
          <div>Manager Keuangan</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // GANTI PIN DI BAWAH INI DENGAN KODE RAHASIA PILIHAN ANDA
    const PIN_RAHASIA = "889900";

    function checkLock() {
      if (sessionStorage.getItem("kdmm_sp_unlocked") === "true") {
        document.getElementById("lockScreen").style.display = "none";
      }
    }

    function unlockApp() {
      const val = document.getElementById("pinInput").value;
      if (val === PIN_RAHASIA) {
        sessionStorage.setItem("kdmm_sp_unlocked", "true");
        document.getElementById("lockScreen").style.display = "none";
        document.getElementById("lockError").style.display = "none";
      } else {
        document.getElementById("lockError").style.display = "block";
      }
    }

    function lockApp() {
      sessionStorage.removeItem("kdmm_sp_unlocked");
      document.getElementById("pinInput").value = "";
      document.getElementById("lockScreen").style.display = "flex";
    }

    let items = [
      { periode: "17 Agustus 2026", menu: "18 Agustus 2026 (3B)", tagihan: 3452950, ket: "Nota terlampir No. T135" },
      { periode: "19 Agustus 2026", menu: "20 Agustus 2026 (3B)", tagihan: 3717800, ket: "Nota terlampir No. T136" },
      { periode: "17 Agustus 2026", menu: "18 Agustus 2026 (Siswa)", tagihan: 15631100, ket: "Nota terlampir No. T137" }
    ];

    function formatAngka(num) {
      return new Intl.NumberFormat("id-ID").format(Math.round(num || 0));
    }

    function renderEditor() {
      const container = document.getElementById("itemsContainer");
      container.innerHTML = "";
      items.forEach((item, index) => {
        const card = document.createElement("div");
        card.className = "item-card";
        card.innerHTML = `
          <div class="item-card-header">
            <span>Baris #${index + 1}</span>
            <button type="button" class="btn btn-danger" onclick="removeItem(${index})">Hapus</button>
          </div>
          <div class="item-grid-2">
            <div class="field-mini">
              <label>Periode</label>
              <input type="text" value="${item.periode}" oninput="updateItem(${index}, 'periode', this.value)" />
            </div>
            <div class="field-mini">
              <label>Penyajian Menu / Ops</label>
              <input type="text" value="${item.menu}" oninput="updateItem(${index}, 'menu', this.value)" />
            </div>
          </div>
          <div class="item-grid-2" style="margin-bottom: 0;">
            <div class="field-mini">
              <label>Jumlah Tagihan (Rp)</label>
              <input type="number" value="${item.tagihan}" oninput="updateItem(${index}, 'tagihan', parseFloat(this.value))" />
            </div>
            <div class="field-mini">
              <label>Keterangan</label>
              <input type="text" value="${item.ket}" oninput="updateItem(${index}, 'ket', this.value)" />
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function render() {
      document.getElementById("outNoSurat").textContent = document.getElementById("inNoSurat").value;
      document.getElementById("outTanggalSurat").textContent = document.getElementById("inTanggalSurat").value;
      document.getElementById("outLampiran").textContent = document.getElementById("inLampiran").value;
      document.getElementById("outPerihal").textContent = document.getElementById("inPerihal").value;
      document.getElementById("outKepada").textContent = document.getElementById("inKepada").value;
      document.getElementById("outPoin1").textContent = document.getElementById("inPoin1").value;
      document.getElementById("outPoin2").textContent = document.getElementById("inPoin2").value;

      const tbody = document.getElementById("outTableBody");
      tbody.innerHTML = "";
      let grandTotal = 0;

      items.forEach((item, idx) => {
        const nilai = item.tagihan || 0;
        grandTotal += nilai;

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="text-center">${idx + 1}</td>
          <td>${item.periode}</td>
          <td>${item.menu}</td>
          <td class="rp-cell">Rp</td>
          <td class="val-cell">${formatAngka(nilai)}</td>
          <td>${item.ket}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById("outGrandTotal").textContent = formatAngka(grandTotal);
    }

    function updateItem(index, field, value) {
      items[index][field] = value;
      render();
    }

    function addItem() {
      items.push({ periode: "", menu: "", tagihan: 0, ket: "Nota terlampir No. " });
      renderEditor();
      render();
    }

    function removeItem(index) {
      items.splice(index, 1);
      renderEditor();
      render();
    }

    function importFromExcel() {
      const raw = document.getElementById("bulkInput").value.trim();
      if (!raw) return;
      const lines = raw.split("\n");
      const parsed = [];

      lines.forEach(line => {
        const cols = line.split("\t");
        if (cols.length >= 4) {
          const periode = cols[0].trim();
          const menu = cols[1].trim();
          const tagihan = parseFloat(cols[2].replace(/[^0-9]/g, "")) || 0;
          const ket = cols[3].trim();
          parsed.push({ periode, menu, tagihan, ket });
        }
      });

      if (parsed.length > 0) {
        items = parsed;
        document.getElementById("bulkInput").value = "";
        renderEditor();
        render();
      } else {
        alert("Format tidak terbaca. Pastikan menyalin 4 kolom berurutan (Periode, Penyajian Menu, Jumlah Tagihan, Keterangan) dari Excel.");
      }
    }

    function saveImage(event, key) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        localStorage.setItem(key, e.target.result);
        loadImages();
      };
      reader.readAsDataURL(file);
    }

    function loadImages() {
      const map = {
        logoKoperasi: "outLogo",
        ttdManager: "outTtdManager"
      };
      Object.keys(map).forEach(key => {
        const data = localStorage.getItem(key);
        const imgEl = document.getElementById(map[key]);
        if (data) {
          imgEl.src = data;
          imgEl.style.display = "inline-block";
        } else {
          imgEl.style.display = "none";
        }
      });
    }

    function clearImages() {
      ["logoKoperasi", "ttdManager"].forEach(k => localStorage.removeItem(k));
      loadImages();
    }

    checkLock();
    loadImages();
    renderEditor();
    render();
  </script>
</body>
</html>
